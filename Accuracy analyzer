import pandas as pd 
from sklearn.tree import DecisionTreeClassifier
from sklearn.model_selection import train_test_split #module for splitting dataset in two
from sklearn.metrics import accuracy_score

pet_data = pd.read_csv(r'C:\Users\Pcuser\Desktop\machine learning\MY FIRST PROJECT\aquarium_dataset_x3.csv')
X = pet_data.drop( columns = ['Animal_species'] )
Y = pet_data['Animal_species']
X_train,X_test,Y_train,Y_test = train_test_split(X,Y,test_size = 1/3 ,random_state = 22,stratify = Y )

model = DecisionTreeClassifier(random_state = 22,min_samples_leaf = 2)
model.fit(X_train,Y_train)
predictions = model.predict(X_test)

score = accuracy_score(Y_test , predictions)
